# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ============================================

# Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-super-secret-key-min-32-characters-long-change-this
ALGORITHM=HS256

# Database (Render PostgreSQL)
DATABASE_URL=sqlite:///./burnout.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis (Optional - for caching, rate limiting)
REDIS_URL=redis://default:password@hostname:port

# CORS - Frontend URLs (comma-separated)
ALLOWED_ORIGINS=https://your-app.netlify.app,https://your-custom-domain.com
FRONTEND_URL=https://your-app.netlify.app

# Email - SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Digital Burnout OS

# Email - SendGrid (Alternative)
USE_SENDGRID=false
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Cloud Storage (Optional - AWS S3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Monitoring - Sentry (Optional)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Server (Render will override PORT)
HOST=0.0.0.0
PORT=8000
WORKERS=2
